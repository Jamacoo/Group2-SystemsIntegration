{
  "manifest_version": 3,
  "name": "TestGuard Companion",
  "version": "1.2",
  "description": "Reports which sites are opened while an exam session is active.",
  "permissions": ["tabs", "storage", "alarms"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["http://*/exam.html*", "https://*/exam.html*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
