# TestGuard Companion creates its own settings file and asks for the
# database address the first time it runs, so you normally never edit this.
# Paste the "Service URI" from your Aiven MySQL service here:
DB_URL="mysql://avnadmin:YOUR_PASSWORD@YOUR_HOST.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED"

PORT=3000

# Optional but recommended when hosting online (e.g. Render): a long random
# text used to sign login cookies. Without it, the database address is used.
# SESSION_SECRET=paste-a-long-random-string
